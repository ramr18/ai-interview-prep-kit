# ---------------------------------------------------------------------------
# AI Interview Prep Kit - environment variables
# Copy to .env (root) for local development. Every variable is documented
# here; the batch entry point (`npm run evaluate`) only needs the LLM ones.
# ---------------------------------------------------------------------------

# --- Server (Express API) ---------------------------------------------------
PORT=4000
# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# SSRF guard. The app fetches untrusted URLs from the open internet; in
# production this must stay false (blocks loopback/private/LAN addresses).
# Set to true ONLY for local development / the batch command when the target
# company site is served from a local address (the assessment does this).
ALLOW_PRIVATE_URLS=false

# CORS: comma-separated list of origins allowed to call the API directly.
# Leave empty when the Next.js app proxies /api (same-origin, recommended).
ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------------
# mongo  -> MongoDB (used by the web app; required in production)
# file  -> JSON-file repository (useful for a DB-free local demo)
REPOSITORY=mongo
MONGODB_URI=mongodb://localhost:27017/ai_prep_kit

# --- LLM --------------------------------------------------------------------
# Choose the provider. gemini       -> Google Gemini (free tier, recommended)
#                      openai       -> any OpenAI-compatible endpoint (Groq, OpenRouter, ...)
#                      mock         -> deterministic offline provider (tests / no-key runs)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# Open a free API key at https://aistudio.google.com/apikey
# If LLM_PROVIDER=openai:
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile

# Free-tier budgets. The pipeline is a sequential set of calls; these guards
# pace requests/tokens and back off before the provider says "slow down".
LLM_RPM=15
LLM_TPM=150000
LLM_TPM_WINDOW_MIN=1
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=120000

# --- Retrieval tuning (sane defaults; rarely need changes) -----------------
PAGE_MAX_BYTES=2097152
FETCH_TIMEOUT_MS=12000
CRAWL_DELAY_MS=450
MAX_PAGES_PER_SITE=24

# --- Frontend (Next.js) ------------------------------------------------------
# Base URL of the Express API. Leave empty so the Next.js server proxies
# /api/* to the backend (recommended: keeps auth cookies same-origin).
# In production with separate origins set e.g. https://api.example.com
NEXT_PUBLIC_API_BASE=